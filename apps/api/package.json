{
	"name": "@intellipick/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"start": "node dist/index.js",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@fastify/cookie": "^11.0.0",
