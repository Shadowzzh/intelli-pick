		"@fastify/rate-limit": "^10.3.0",
		"@intellipick/ai": "workspace:*",
		"@intellipick/config": "workspace:*",
		"@intellipick/db": "workspace:*",
		"@intellipick/env": "workspace:*",
		"@intellipick/events": "workspace:*",
		"@intellipick/shared": "workspace:*",
		"ai": "^4.0.0",
		"bullmq": "^5.0.0",
		"dayjs": "^1.11.0",
		"drizzle-orm": "^0.38.0",
		"fastify": "^5.6.2",
		"graphql": "^16.12.0",
		"mercurius": "^16.6.0",
		"socket.io": "^4.8.3",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^4.0.16",
		"tsup": "^8.5.1",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^4.0.16"
	}
