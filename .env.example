# ============================================
# 环境变量配置示例
# ============================================
#
# 开发环境：
#   - 复制此文件为 .env
#   - 填入真实的配置值
#   - DATABASE_URL 和 REDIS_URL 使用 localhost
#
# 生产环境（Docker）：
#   - 复制此文件为 .env.production
#   - 填入真实的配置值
#   - DATABASE_URL 使用: postgresql://postgres:POSTGRES_PASSWORD@db:5432/ai_filter
#   - REDIS_URL 使用: redis://redis:6379
#   - 同时设置 POSTGRES_PASSWORD（见下方）
# ============================================

# 环境配置
NODE_ENV=development

# 日志配置
LOG_LEVEL=info
LOG_PRETTY=true

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_filter

# Redis
REDIS_URL=redis://localhost:6379

# Network Proxy (可选)
# 如果需要通过代理访问外网，设置此变量
# 开发环境: http://127.0.0.1:7890
# Docker 环境: http://host.docker.internal:7890
HTTP_PROXY=

# RSSHub 地址
# 本地开发使用 http://localhost:1200
# Docker Worker 使用 http://intellipick-rsshub:1200
RSSHUB_BASE_URL=http://localhost:1200

# Worker 启动行为
CLEAR_QUEUE_ON_START=false
RUN_INITIAL_COLLECTION=false

# AI Providers
SUB2API_API_KEY=your_sub2api_key
SUB2API_BASE_URL=http://127.0.0.1:18090
# 统一兜底模型；任务级配置优先于此值
SUB2API_MODEL=gpt-5.6-sol
SUB2API_FILTER_MODEL=gpt-5.6-luna
SUB2API_EXTRACT_AND_CLASSIFY_MODEL=gpt-5.6-terra
SUB2API_CHAT_MODEL=gpt-5.6-luna
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=your_openai_key

# Twitter (可选)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_REFRESH_TOKEN=

# ============================================
# Docker 生产环境额外配置
# ============================================
# 仅在 .env.production 中需要
POSTGRES_PASSWORD=your_secure_password

# RSSHub 代理配置（可选）
# 如果 RSSHub 需要通过代理访问某些网站，设置以下变量
# 留空则不使用代理
RSSHUB_HTTP_PROXY=http://host.docker.internal:7890
RSSHUB_HTTPS_PROXY=http://host.docker.internal:7890

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=*
API_RATE_LIMIT=100
API_PORT_MAPPING=8085
WEB_PORT=8080
DB_PORT_MAPPING=15432:5432
RSSHUB_PORT_MAPPING=1200:1200

# 单用户登录认证
# AUTH_PASSWORD_HASH 使用 API 提供的 Scrypt 格式，不要填写明文密码
AUTH_USERNAME=sift
AUTH_PASSWORD_HASH=scrypt:16384:8:1:64:replace_with_salt:replace_with_hash
AUTH_SESSION_SECRET=replace_with_at_least_32_random_characters
AUTH_SESSION_TTL_HOURS=12
AUTH_REMEMBER_TTL_DAYS=30

# GraphQL
# 生产环境默认保持关闭，需要调试时再临时开启
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false

# ============================================
# Web Frontend Configuration
# ============================================
# 前端 API 地址配置

# 开发环境：使用相对路径，由 Vite 代理转发到后端
VITE_API_URL=/

# WebSocket 地址：开发环境直接连接到后端
VITE_SOCKET_URL=ws://localhost:3000

# Vite 代理目标（可选）
# 留空则自动使用 http://localhost:API_PORT
# 如果后端运行在其他地址，可以显式指定：
# VITE_API_PROXY_TARGET=http://localhost:3000

# 生产环境配置示例（在构建时使用）：
# VITE_API_URL=http://your-domain.com
# VITE_SOCKET_URL=ws://your-domain.com
