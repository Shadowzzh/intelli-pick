# ============================================
# 环境变量配置示例
# ============================================
#
# 开发环境：
#   - 复制此文件为 .env
#   - 填入真实的配置值
#   - DATABASE_URL 和 REDIS_URL 使用 localhost
#
# 生产环境（Docker）：
#   - 复制此文件为 .env.production
#   - 填入真实的配置值
#   - DATABASE_URL 使用: postgresql://postgres:POSTGRES_PASSWORD@db:5432/ai_filter
#   - REDIS_URL 使用: redis://redis:6379
#   - 同时设置 POSTGRES_PASSWORD（见下方）
# ============================================

# 环境配置
NODE_ENV=development

# 日志配置
LOG_LEVEL=info
LOG_PRETTY=true

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_filter

# Redis
REDIS_URL=redis://localhost:6379

# Network Proxy (可选)
# 如果需要通过代理访问外网，设置此变量
# 开发环境: http://127.0.0.1:7890
# Docker 环境: http://host.docker.internal:7890
HTTP_PROXY=

# AI Providers
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=your_openai_key

# AI Chat Configuration
AI_CHAT_ENABLED=true
AI_CHAT_MODEL=deepseek-chat

# Twitter (可选)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_REFRESH_TOKEN=

# ============================================
# Docker 生产环境额外配置
# ============================================
# 仅在 .env.production 中需要
POSTGRES_PASSWORD=your_secure_password

# RSSHub 代理配置（可选）
# 如果 RSSHub 需要通过代理访问某些网站，设置以下变量
# 留空则不使用代理
RSSHUB_HTTP_PROXY=http://host.docker.internal:7890
RSSHUB_HTTPS_PROXY=http://host.docker.internal:7890

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=*
API_RATE_LIMIT=100

# GraphQL
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# ============================================
# Web Frontend Configuration
# ============================================
# 前端 API 地址配置

# 开发环境：使用相对路径，由 Vite 代理转发到后端
VITE_API_URL=/

# WebSocket 地址：开发环境直接连接到后端
VITE_SOCKET_URL=ws://localhost:3000

# Vite 代理目标（可选）
# 留空则自动使用 http://localhost:API_PORT
# 如果后端运行在其他地址，可以显式指定：
# VITE_API_PROXY_TARGET=http://localhost:3000

# 生产环境配置示例（在构建时使用）：
# VITE_API_URL=http://your-domain.com
# VITE_SOCKET_URL=ws://your-domain.com
