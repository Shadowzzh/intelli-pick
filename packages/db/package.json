{
	"name": "@intellipick/db",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"dev": "tsup --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@intellipick/env": "workspace:*",
		"drizzle-orm": "^0.38.0",
		"nanoid": "^5.0.0",
		"postgres": "^3.4.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"dotenv": "^16.4.0",
		"drizzle-kit": "^0.30.0",
		"typescript": "^5.7.0"
	}
}
